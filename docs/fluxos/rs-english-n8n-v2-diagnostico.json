        "jsCode": "const body=$json.body??{};\nconst data=body.data??{};\nconst key=data.key??{};\nconst m=data.message??{};\nconst jid=key.remoteJid??'';\nconst phone=String(jid).replace('@s.whatsapp.net','').replace('@c.us','').replace(/\\D/g,'');\nconst text=m.conversation??m.extendedTextMessage?.text??m.imageMessage?.caption??m.videoMessage?.caption??'';\nreturn [{json:{\n event:body.event??'',\n phone,\n name:data.pushName??'Aluno',\n message:String(text).trim(),\n message_type:data.messageType??'unknown',\n from_me:Boolean(key.fromMe),\n is_group:jid.includes('@g.us'),\n evolution_server:body.server_url??'',\n evolution_instance:body.instance??''\n}}];"
