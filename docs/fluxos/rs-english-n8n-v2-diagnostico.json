    {
      "parameters": {
        "jsCode": "const r=$json;\nlet text=r.output_text;\nif(!text&&Array.isArray(r.output)){const p=[];for(const i of r.output){for(const c of(i.content??[])){if(typeof c.text==='string')p.push(c.text)}}text=p.join('\\n')}\ntext=String(text??'').replace(/^```json\\s*/i,'').replace(/^```\\s*/i,'').replace(/```$/i,'').trim();\nlet diagnostic;\ntry{diagnostic=JSON.parse(text)}catch(e){diagnostic={reply:\"I couldn't evaluate that. Could you answer again in English? 😊\",current_step:0,next_step:0,complete:false,estimated_level:\"A1\",scores:{},strengths:[],weaknesses:[],recommendations:[],study_plan:{}}}\nreturn [{json:{diagnostic,teacher_message:diagnostic.reply}}];"
      },
