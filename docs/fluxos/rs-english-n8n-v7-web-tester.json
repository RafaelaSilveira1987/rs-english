        "jsCode": "const b=$json.body??$json;\nreturn [{json:{\n  student_id:b.student_id??'',\n  name:b.name??'Aluno',\n  phone:String(b.phone??'').replace(/\\D/g,''),\n  message:String(b.message??'').trim(),\n  message_type:'text',\n  channel:'web'\n}}];"
      },
