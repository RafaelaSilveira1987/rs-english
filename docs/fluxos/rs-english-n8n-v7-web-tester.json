    },
    {
      "parameters": {
        "jsCode": "const r=$json;\nlet text=r.output_text;\nif(!text&&Array.isArray(r.output)){\n const p=[];\n for(const item of r.output){\n  for(const c of(item.content??[])){\n   if(typeof c.text==='string')p.push(c.text)\n  }\n }\n text=p.join('\\n');\n}\ntext=String(text??'').replace(/^```json\\s*/i,'').replace(/^```\\s*/i,'').replace(/```$/i,'').trim();\nlet evaluation;\ntry{evaluation=JSON.parse(text)}\ncatch(e){evaluation={grammar_score:null,vocabulary_score:null,fluency_score:null,comprehension_score:null,errors:[],skills:[],vocabulary:[],review_results:[],error_review_results:[]}}\nreturn [{json:{evaluation}}];"
      },
