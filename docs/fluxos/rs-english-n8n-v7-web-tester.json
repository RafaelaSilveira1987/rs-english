      "id": "43762943-3843-43be-8bdc-6434ddb1e9af",
      "name": "Teacher IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        430,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$json;\nlet text=r.output_text;\nif(!text&&Array.isArray(r.output)){\n const p=[];\n for(const item of r.output){\n  for(const c of(item.content??[])){\n   if(typeof c.text==='string')p.push(c.text)\n  }\n }\n text=p.join('\\n');\n}\nreturn [{json:{teacher_message:String(text??'').trim()}}];"
      },
      "id": "a4e7b234-c791-4573-9c1d-1b4289ce57bd",
      "name": "Extrair Teacher",
