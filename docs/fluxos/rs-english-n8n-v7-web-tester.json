    {
      "parameters": {
        "jsCode": "const j=$json,s=j.student||{};\nconst due=j.reviews_due||{vocabulary:[],errors:[],total:0};\n\nconst teacherPrompt=`\nVocê é Emma, professora particular de inglês do RS English.\n\nAluno: ${s.name||j.name||'Aluno'}\nNível: ${s.overall_level||'A1'}\nObjetivo: ${s.goal||'Aprender inglês'}\nCorreção: ${s.correction_mode||'balanced'}\n\nPlano:\n${JSON.stringify(j.active_plan||{})}\n\nFragilidades:\n${JSON.stringify(j.weaknesses||[])}\n\nRevisões:\n${JSON.stringify(due)}\n\nHistórico:\n${JSON.stringify(j.recent_messages||[])}\n\nMensagem atual:\n${j.message}\n\nRegras:\n- converse principalmente em inglês;\n- para A1/A2 use português só se realmente ajudar;\n- no máximo 1 ou 2 correções importantes;\n- continue com uma pergunta curta ou microatividade;\n- não invente evolução;\n- não altere oficialmente o nível CEFR.\n\nResponda somente a mensagem para o aluno.\n`.trim();\n\nconst evaluatorPrompt=`\nAvalie silenciosamente:\n${j.message}\n\nNível: ${s.overall_level||'A1'}\n\nRetorne SOMENTE JSON:\n{\n \"grammar_score\":0,\n \"vocabulary_score\":0,\n \"fluency_score\":0,\n \"comprehension_score\":0,\n \"errors\":[],\n \"skills\":[],\n \"vocabulary\":[],\n \"review_results\":[],\n \"error_review_results\":[]\n}\n`.trim();\n\nreturn [{json:{...j,teacher_prompt:teacherPrompt,evaluator_prompt:evaluatorPrompt}}];"
      },
      "id": "41183fed-4c97-43ab-be29-3ef37b35dbc0",
      "name": "Montar Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
