      "position": [
        420,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$json;let text=r.output_text;if(!text&&Array.isArray(r.output)){const p=[];for(const i of r.output){for(const c of(i.content??[])){if(typeof c.text==='string')p.push(c.text)}}text=p.join('\\n')}return [{json:{teacher_summary:String(text??'').trim()}}];"
      },
