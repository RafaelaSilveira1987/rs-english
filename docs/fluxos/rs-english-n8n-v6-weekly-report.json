      "typeVersion": 4.2,
      "position": [
        -90,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$json.report_data; const prompt=`Você é Emma, professora do RS English. Crie um relatório semanal curto para WhatsApp. DADOS: ${JSON.stringify(d)}. Regras: português; não invente dados; máximo 900 caracteres; inclua resumo, 2 evoluções, foco da próxima semana e mensagem final. Retorne somente a mensagem.`; return [{json:{...$json,teacher_prompt:prompt}}];"
      },
      "id": "63b72e2b-e11a-47c7-aeb9-9fe2a920149b",
      "name": "Montar Prompt Relatório",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer SUA_OPENAI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model:($env.OPENAI_TEXT_MODEL || 'gpt-5.6-luna'), input:$json.teacher_prompt } }}",
        "options": {}
      },
      "id": "822ed3b8-c5fd-4c76-a01f-33d614b1f323",
      "name": "Gerar Relatório IA",
      "type": "n8n-nodes-base.httpRequest",
